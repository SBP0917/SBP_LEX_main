project Spark_Safety_Monitor is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("spark_safety_monitor.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end Spark_Safety_Monitor;
