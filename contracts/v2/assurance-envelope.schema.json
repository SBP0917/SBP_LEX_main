{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbp.local/contracts/v2/assurance-envelope.schema.json",
  "title": "SBP-LEX V2 assurance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_fingerprint",
    "checkpoint",
    "sequence",
    "previous_envelope_sha512",
    "canonical_state_b64",
    "canonical_state_sha512"
  ],
  "properties": {
    "schema_version": {
      "const": "sbp.v2.assurance-envelope/1"
    },
    "request_fingerprint": {
      "$ref": "#/$defs/sha512"
    },
    "checkpoint": {
      "enum": [
        "state_construction",
        "authority_first",
        "governance_grc",
        "domain_aurion_convergence",
        "execution_gate_input",
        "terminal_audit"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "previous_envelope_sha512": {
      "oneOf": [
        { "const": "GENESIS" },
        { "$ref": "#/$defs/sha512" }
      ]
    },
    "canonical_state_b64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1398104,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "canonical_state_sha512": {
      "$ref": "#/$defs/sha512"
    }
  },
  "$defs": {
    "sha512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
